#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

CONFIG_ZMK_POINTING=y

// LAYERS

#define DEFAULT 0
#define NUM     1
#define SYM     2
#define FUNC    3
#define NAV     4

// MACROS

#define SUPER LC(LSHIFT)
#define SUPER2 LA(LC(LSHIFT))

// Opposite-hand key positions, used to restrict homerow mod holds to
// cross-hand chords so same-hand rolls resolve as taps.

#define LEFT_HAND_KEYS 1 2 3 4 5 13 14 15 16 17 25 26 27 28 29 36 37 38
#define RIGHT_HAND_KEYS 6 7 8 9 10 18 19 20 21 22 30 31 32 33 34 39 40 41

&mt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
};

/ {
    behaviors {
        hml: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_LEFT";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <RIGHT_HAND_KEYS>;
            hold-trigger-on-release;
        };

        hmr: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_RIGHT";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <LEFT_HAND_KEYS>;
            hold-trigger-on-release;
        };

        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_DANCE_0";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&hmr RGUI SEMI>, <&kp SQT>;
        };

        td1: tap_dance_1 {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_DANCE_1";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt LCTRL TAB>, <&kp ESC>;
        };

        new_behavior: new_behavior {
            compatible = "zmk,behavior-mouse-key-press";
            label = "NEW_BEHAVIOR";
            #binding-cells = <1>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_cword {
            timeout-ms = <50>;
            key-positions = <16 19>;
            require-prior-idle-ms = <150>;
            bindings = <&caps_word>;
        };

        combo_vimwq {
            timeout-ms = <50>;
            key-positions = <1 2>;
            require-prior-idle-ms = <150>;
            bindings = <&vim_quit>;
        };
    };

    macros {
        vim_quit: vim_quit {
            label = "ZM_vim_quit";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp ESC &kp COLON &kp W &kp Q>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&msc SCRL_LEFT  &kp Q  &kp W  &kp E                 &kp R  &kp T      &kp Y      &kp U                        &kp I      &kp O    &kp P         &to 4
&mmv MOVE_DOWN  &kp A  &kp S  &kp D                 &kp F  &kp G      &kp H      &kp J                        &kp K      &kp L    &kp SQT       &to 3
&mmv MOVE_UP    &kp Z  &kp X  &kp C                 &kp V  &kp B      &kp N      &kp M                        &kp COMMA  &kp DOT  &kp QUESTION  &kp RG(SPACE)
                              &mt (LEFT_GUI) LG(Q)  &to 2  &kp RET    &kp SPACE  &mt RG(BACKSPACE) BACKSPACE  &to 1
            >;
        };

        num_layer {
            bindings = <
&kp TAB    &kp ESC             &kp LA(LEFT)  &kp UP    &kp LA(RIGHT)     &kp PG_UP            &kp PLUS      &kp N7          &kp N8  &kp N9  &kp KP_MULTIPLY  &kp LEFT_PARENTHESIS
&kp GRAVE  &kp C_AC_FAVORITES  &kp LEFT      &kp DOWN  &kp RIGHT         &kp PG_DN            &kp MINUS     &kp N4          &kp N5  &kp N6  &kp SLASH        &kp SEMICOLON
&none      &kp SUPER2          &none         &none     &kp C_AC_ZOOM_IN  &kp C_AC_ZOOM_OUT    &kp N0        &kp N1          &kp N2  &kp N3  &kp DOT          &kp RIGHT_PARENTHESIS
                                             &trans    &mmv MOVE_RIGHT   &mmv MOVE_LEFT       &mmv MOVE_UP  &mmv MOVE_DOWN  &to 0
            >;
        };

        sym_layer {
            bindings = <
&none  &kp EXCL   &kp AT     &kp HASH           &kp DLLR   &kp PRCNT    &kp CARET  &kp AMPS   &kp KP_MULTIPLY  &kp LPAR  &kp RPAR  &none
&none  &kp GRAVE  &kp TILDE  &kp DOUBLE_QUOTES  &kp COLON  &none        &kp MINUS  &kp EQUAL  &kp LBKT         &kp RBKT  &kp BSLH  &kp SEMICOLON
&none  &kp TILDE  &none      &none              &none      &none        &kp UNDER  &kp PLUS   &kp LBRC         &kp RBRC  &kp PIPE  &none
                             &trans             &to 4      &trans       &trans     &to 4      &to 0
            >;
        };

        func_layer {
            bindings = <
&none              &kp F1        &kp F2          &kp F3        &kp F4      &kp F5              &kp F6                &kp F7              &kp F8         &kp F9             &kp F10  &kp C_PIP
&ext_power EP_OFF  &none         &studio_unlock  &kp C_PREV    &kp C_NEXT  &kp C_PLAY_PAUSE    &kp C_MUTE            &kp C_VOL_DN        &kp C_VOL_UP   &kp C_SLEEP_MODE   &kp F11  &kp C_AL_CONTROL_PANEL
&ext_power EP_ON   &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_NXT  &bt BT_CLR          &kp C_AL_SELECT_TASK  &kp C_BRI_DEC       &kp C_BRI_INC  &kp K_SCREENSAVER  &kp F12  &none
                                                 &sys_reset    &trans      &bootloader         &kp C_AL_NEXT_TASK    &kp C_AL_PREV_TASK  &to 0
            >;
        };

        layer_4 {
            bindings = <
&kp C_AC_DESKTOP_SHOW_ALL_WINDOWS  &kp C_AC_SEARCH  &kp K_SCREENSAVER  &kp RS(RG(N))   &kp RS(RG(T))      &kp K_COPY          &trans          &mkp MB4      &trans          &trans           &trans    &trans
&kp K_REDO                         &kp K_UNDO       &kp K_REFRESH      &kp RG(W)       &kp RG(N)          &kp INSERT          &mmv MOVE_LEFT  &mmv MOVE_UP  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &mkp MB5  &to 0
&kp C_AC_CUT                       &kp C_AC_GOTO    &kp K_SLEEP        &kp C_AC_CLOSE  &kp C_AC_OPEN      &kp K_PASTE         &trans          &trans        &trans          &trans           &trans    &trans
                                                                       &trans          &kp C_AC_ZOOM_OUT  &kp C_AC_ZOOM_IN    &mkp LCLK       &mkp MCLK     &mkp RCLK
            >;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };
    };
};
